<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Mimo Spark</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>mimo_spark</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- Permissions -->
	<key>NSCameraUsageDescription</key>
	<string>Mimo Spark utilise la caméra pour le scan HUD (NDI).</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Mimo Spark se connecte à l'adaptateur OBD2 Wi-Fi pour lire les données du véhicule.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Mimo Spark utilise votre position pour la navigation GPS et le suivi de trajet.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Mimo Spark utilise votre position en arrière-plan pour continuer le suivi GPS même si l'écran est verrouillé.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Mimo Spark utilise votre position en arrière-plan pour le suivi de trajet.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Mimo Spark utilise le microphone pour l'assistant vocal (commandes vocales).</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Mimo Spark utilise la reconnaissance vocale pour les commandes mains-libres pendant la conduite.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Mimo Spark peut utiliser le Bluetooth pour la connexion à l'adaptateur OBD2.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Mimo Spark peut utiliser le Bluetooth pour la connexion à l'adaptateur OBD2.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>fetch</string>
		<string>processing</string>
	</array>
</dict>
</plist>
